# Copiar a .env (local) o Variables de Railway.
# Nunca commitees secretos.

# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://tu-servicio.up.railway.app
SESSION_SECRET=cambiar-por-64-caracteres-aleatorios-minimo-xxxxxxxxxxxxxxxx
CRON_SECRET=cambiar-cron-secret-aleatorio
ADMIN_EMAIL=tu-correo@dominio.pe
ADMIN_PASSWORD=cambia-esta-clave-larga
# ADMIN_DNI=40821937
# ADMIN_TELEFONO=987001122

# Postgres (plugin Railway o Neon)
DATABASE_URL=postgresql://user:pass@host/alquila?sslmode=require

# Cobrar fee de publicación (S/ 9.90) — pon 1 en Railway
ALQUILA_PAYMENTS_ENABLED=1
ALQUILA_PAYMENT_PHASE=1
MP_ACCESS_TOKEN=

# Fotos: Cloudflare R2 / AWS S3 (el disco de Railway no persiste uploads)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://pub-xxxx.r2.dev

# OTP: al menos UNO en producción (Twilio SMS o Resend correo)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=Alquila <noreply@tu-dominio.pe>

# Soporte (footer)
SOPORTE_EMAIL=soporte@tu-dominio.pe
SOPORTE_WHATSAPP=51XXXXXXXXX
