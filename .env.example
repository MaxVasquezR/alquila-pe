# Alquila — variables de entorno

# Base de datos — PostgreSQL (Neon/Supabase/Vercel Postgres en producción)
# Local con Docker: npm run docker:up → DATABASE_URL abajo
DATABASE_URL="postgresql://alquila:alquila_dev@localhost:5432/alquila?schema=public"
# SQLite solo desarrollo sin Docker (cambiar provider en schema.prisma a sqlite):
# DATABASE_URL="file:./dev.db"

# Sesión (mínimo 32 caracteres en producción)
SESSION_SECRET="cambiar-en-produccion-clave-secreta-minimo-64-caracteres-aleatorios"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fase de pagos: 1 = bumps/Premium, 2 = + escrow garantía (obligatorio en demo seria), 3 = + comisión GMV
ALQUILA_PAYMENT_PHASE="2"

# Mercado Pago Perú (https://www.mercadopago.com.pe/developers)
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Cron (Vercel cron o manual)
CRON_SECRET="cambiar-cron-secret"

# Admin bootstrap (email del primer admin)
ADMIN_EMAIL="admin@alquila.pe"

# Soporte Alquila (footer — separado del WhatsApp P2P entre usuarios)
SOPORTE_EMAIL="soporte@alquila.pe"
SOPORTE_WHATSAPP=""

# Twilio SMS OTP (opcional — sin esto usa OTP demo 184729)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# S3 / R2 / compatible (opcional — sin esto usa public/uploads local)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
